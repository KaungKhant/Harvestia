; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2d farming"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ToolManager="*res://scripts/globals/tool_manager.gd"
InventoryManager="*res://scripts/globals/inventory_manager.gd"
DayAndNightCycleManager="*res://scripts/globals/day_and_night_cycle_manager.gd"
GameDialogueManager="*res://scripts/globals/game_dialogue_manager.gd"
PlayerProgressManager="*res://scripts/globals/player_progress_manager.gd"
NotificationManager="*res://scripts/globals/notification_manager.gd"
QuestManager="*res://scripts/globals/quest_manager.gd"
AreaManager="*res://scripts/globals/area_manager.gd"
StageManager="*res://stage_manager.tscn"
SaveGameManager="*res://scripts/globals/save_game_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Global="*res://scripts/Global.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=480
window/size/mode=2
window/size/window_width_override=1270
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/layer_1="Chicken Nav"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://Dialog/": "purple",
"res://scene/": "yellow",
"res://scripts/": "red",
"res://tilesets/": "green"
}

[global_group]

navigation_polygon_source_geometry_group=""
player=""

